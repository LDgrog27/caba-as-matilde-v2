# Copia estas variables en Vercel → Project → Settings → Environment Variables.
# Sin FIREBASE_SERVICE_ACCOUNT el sitio funciona en MODO DEMO (datos de ejemplo en el navegador).

# Clave de servicio de Firebase (Firestore). Pega TODO el JSON descargado, en una sola línea.
FIREBASE_SERVICE_ACCOUNT=

# Texto largo y secreto (20+ caracteres) para firmar los botones "Confirmar / Rechazar" de los correos.
RESERVAS_SECRET=

# Correos (Resend). OWNER_EMAIL puede tener varios separados por coma.
RESEND_API_KEY=
MAIL_FROM=Cabañas Matilde <reservas@tudominio.com>
OWNER_EMAIL=

# Opcionales
SITE_URL=https://tu-sitio.vercel.app
WHATSAPP=528125800115
